{
  "name": "eshop",
  "version": "0.1.0",
  "description": "PDF Financials Tracker - Cloudflare-based application for tracking financial reports",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "npm run build:frontend && npm run build:api",
    "build:frontend": "vite build",
    "build:api": "tsc --project tsconfig.api.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.api.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "test": "echo 'Tests passed (placeholder for future implementation)'",
    "ci": "npm run lint && npm run typecheck && npm run build && npm test",
    "db:migrate": "wrangler d1 migrations apply eshop-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply eshop-db --remote",
    "db:seed": "wrangler d1 execute eshop-db --local --file=./scripts/seed.sql"
  },
  "keywords": [
    "pdf",
    "financial",
    "tracker",
    "cloudflare"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251229.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "wrangler": "^4.54.0"
  }
}
